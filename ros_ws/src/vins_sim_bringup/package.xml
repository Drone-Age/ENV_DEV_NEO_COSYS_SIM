<?xml version="1.0"?>
<package format="3">
  <name>vins_sim_bringup</name>
  <version>2.0.0</version>
  <description>Backend-neutral VINS/iMAVROS bringup for INDRA simulation.</description>
  <maintainer email="dev@drone-age.com">Drone Age</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>feature_tracker</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ihub</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>vins_estimator</exec_depend>
  <exec_depend>vins_initializer</exec_depend>
  <exec_depend>vision_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
