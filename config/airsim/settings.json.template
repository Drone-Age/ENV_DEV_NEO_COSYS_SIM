{
  "SeeDocsAt": "https://cosys-lab.github.io/Cosys-AirSim/settings/",
  "SettingsVersion": 2.0,
  "SimMode": "Multirotor",
  "ClockType": "ScalableClock",
  "ClockSpeed": __CLOCK_SPEED__,
  "ApiServerPort": __RPC_PORT__,
  "OriginGeopoint": {
    "Latitude": __ORIGIN_LAT__,
    "Longitude": __ORIGIN_LON__,
    "Altitude": __ORIGIN_ALT__
  },
  "CameraDefaults": {
    "CaptureSettings": [
      {
        "ImageType": 0,
        "Width": 640,
        "Height": 480,
        "FOV_Degrees": 65,
        "AutoExposureMethod": 2,
        "AutoExposureApplyPhysicalCameraExposure": true,
        "AutoExposureBias": 0,
        "CameraISO": 100,
        "CameraShutterSpeed": 500,
        "CameraAperture": 11,
        "MotionBlurAmount": 0,
        "BloomIntensity": 0,
        "LumenGIEnable": false,
        "LumenReflectionEnable": false,
        "ForceUpdate": false
      }
    ]
  },
  "Vehicles": {
    "Copter": {
      "VehicleType": "ArduCopter",
      "AutoCreate": true,
      "UseSerial": false,
      "LocalHostIp": "__WINDOWS_IP__",
      "UdpIp": "__WSL_IP__",
      "UdpPort": __SENSOR_PORT__,
      "ControlPort": __CONTROL_PORT__,
      "Sensors": {
        "BodyImu": {
          "SensorType": 2,
          "Enabled": true,
          "GenerateNoise": false
        },
        "CameraImu": {
          "SensorType": 2,
          "Enabled": true,
          "GenerateNoise": false
        }
      }
    }
  }
}
